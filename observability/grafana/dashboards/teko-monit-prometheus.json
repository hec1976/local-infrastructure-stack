  "timezone": "browser",
  "title": "TEKO Monit · System Health",
  "uid": "teko-monit-prometheus",
  "version": 90,
  "description": "Monit System Health direkt aus Loki. Der TEKO Monit Exporter liefert Status/Metriken; der System-Loki-Importer spiegelt eine gezielt begrenzte Messwertmenge nach Loki. Kein separater Prometheus-Server erforderlich.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Monit Datenerfassung",
      "description": "1 = Monit-Exporter wird erfolgreich durch den Loki-Importer gelesen.",
      "datasource": {
        "type": "loki",
        "uid": "teko-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "teko-loki"
          },
          "editorMode": "code",
          "expr": "max_over_time({service=\"monit\",kind=\"metric\",metric=\"monit_up\"} | json | unwrap value [$__range])",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
