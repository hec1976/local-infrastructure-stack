# Kopieren nach: standalone/data/config-manager.env
# Datei danach mit chmod 640 schützen, sie enthält das API-Token für den
# Config-Agent (Backend, unverändert).

CONFIG_MANAGER_API_TOKEN=hier-token-eintragen

CONFIG_MANAGER_TLS_VERIFY=false
CONFIG_MANAGER_TLS_VERIFY_HOST=false
CONFIG_MANAGER_TLS_CA_FILE=

CONFIG_MANAGER_HTTP_CONNECT_TIMEOUT=10
CONFIG_MANAGER_HTTP_TIMEOUT=20
CONFIG_MANAGER_GIT_DEPLOY_HTTP_TIMEOUT=300
CONFIG_MANAGER_GIT_UPLOAD_HTTP_TIMEOUT=600

# Server 0 = Config-Agent Instanz 1 (z.B. Datacenter A)
CONFIG_MANAGER_SERVERS_0_NAME=teko
CONFIG_MANAGER_SERVERS_0_URL=https://127.0.0.1:5008


# Fleet / Desired State
CONFIG_MANAGER_SERVER_REGISTRY_FILE=/opt/service/config-manager/servers.json
CONFIG_MANAGER_DESIRED_STATE_FILE=/srv/www/config-manager-standalone/standalone/data/desired_state.json

# Oeffentliche Basis-URL fuer Agent-basierte Observability-Ingest-Endpunkte.
CONFIG_MANAGER_PUBLIC_BASE_URL=https://config-manager.local
